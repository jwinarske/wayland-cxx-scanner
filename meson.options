# SPDX-License-Identifier: MIT
option('tests',    type: 'boolean', value: false, description: 'Build and run unit/integration tests')
option('examples', type: 'boolean', value: false, description: 'Build example applications')
option('docs',     type: 'boolean', value: false, description: 'Generate Doxygen HTML documentation')
# Parity with CMake's WAYLAND_CXX_SCANNER_INSTALL_TOOL — gate installing the exe.
option('install_tool', type: 'boolean', value: true, description: 'Install the scanner executable')
option('ime_backend', type: 'combo',
    choices: ['none', 'text-input-v1', 'text-input-v3',
              'input-method-v1', 'input-method-v2', 'virtual-keyboard-v1'],
    value: 'text-input-v1',
    description: 'IME protocol backend to generate, wrap, build and test (exactly one). Implemented: none, text-input-v1, text-input-v3.')
# Skia-backed rendering examples. Disabled by default: Skia is a heavyweight
# out-of-tree dependency and examples=true alone must never require it.
option('skia_examples', type: 'feature', value: 'disabled',
    description: 'Build the Skia-backed rendering examples (requires a Skia build; see scripts/build-skia.sh)')
option('skia_prefix', type: 'string', value: '',
    description: 'Path to an out-of-tree Skia build prefix (headers reachable as include/core/..., static libs under lib/) used when Skia is not found via pkg-config')
# Dear ImGui platform-backend example. Disabled by default for the same reason
# as skia_examples: enabling it fetches and builds an out-of-tree dependency,
# and examples=true alone must never do that.
option('imgui_examples', type: 'feature', value: 'disabled',
    description: 'Build the Dear ImGui platform-backend example (fetches Dear ImGui via subprojects/imgui.wrap unless a system imgui is found)')
