# SPDX-License-Identifier: MIT
option('tests',    type: 'boolean', value: false, description: 'Build and run unit/integration tests')
option('examples', type: 'boolean', value: false, description: 'Build example applications')
option('docs',     type: 'boolean', value: false, description: 'Generate Doxygen HTML documentation')
# Parity with CMake's WAYLAND_CXX_SCANNER_INSTALL_TOOL — gate installing the exe.
option('install_tool', type: 'boolean', value: true, description: 'Install the scanner executable')
option('ime_backend', type: 'combo',
    choices: ['none', 'text-input-v1', 'text-input-v3',
              'input-method-v1', 'input-method-v2', 'virtual-keyboard-v1'],
    value: 'text-input-v1',
    description: 'IME protocol backend to generate, wrap, build and test (exactly one). Implemented: none, text-input-v1, text-input-v3.')
# Skia-backed rendering examples. Disabled by default: Skia is a heavyweight
# out-of-tree dependency and examples=true alone must never require it.
option('skia_examples', type: 'feature', value: 'disabled',
    description: 'Build the Skia-backed rendering examples (requires a Skia build; see scripts/build-skia.sh)')
option('skia_prefix', type: 'string', value: '',
    description: 'Path to an out-of-tree Skia build prefix (headers reachable as include/core/..., static libs under lib/) used when Skia is not found via pkg-config')
# Dear ImGui platform-backend example. Disabled by default for the same reason
# as skia_examples: enabling it fetches and builds an out-of-tree dependency,
# and examples=true alone must never do that.
option('imgui_examples', type: 'feature', value: 'disabled',
    description: 'Build the Dear ImGui platform-backend example (fetches Dear ImGui via subprojects/imgui.wrap unless a system imgui is found)')
# Which GTK the themed CSD plugin is built against. 'auto' resolves to gtk3 when
# gtk+-3.0 is present and skips the plugin otherwise; an explicit 'gtk3' is a
# hard requirement. 'gtk4' is accepted but not yet implemented, and says so
# rather than silently building nothing.
option('csd_gtk', type: 'combo', choices: ['auto', 'gtk3', 'gtk4', 'disabled'],
    value: 'auto',
    description: 'GTK version the themed CSD plugin is built against. Implemented: gtk3.')
# How the xdg-csd example gets its window decorations.
#
#   ssd       no plugin is compiled at all; the example asks the compositor for
#             server-side decorations and draws none itself. The binary carries
#             no toolkit dependency of any kind.
#   auto      compile the highest-fidelity plugin available, but still ask for
#             server-side decorations first and only draw our own if the
#             compositor refuses. What a well-behaved client wants.
#   gtk       |
#   cairo     | compile that plugin and ask for client-side decorations, even
#   fallback  | where the compositor offers to do it. Naming a plugin means
#             | wanting to see it.
#
# Defaults to 'ssd', so a decoration plugin is only ever built when asked for by
# name. Same reasoning as skia_examples and imgui_examples above: examples=true
# alone must never drag in a toolkit, and anything else would pull GTK in on any
# machine that happens to have it.
#
# 'ssd' outranks csd_gtk, which has nothing to select when no plugin is built.
# Naming a plugin that cannot be built is a configure error rather than a silent
# downgrade, which is what lets CI pin one and build the ones that would
# otherwise never be reached.
option('csd', type: 'combo',
    choices: ['ssd', 'auto', 'gtk', 'cairo', 'fallback'],
    value: 'ssd',
    description: 'How the xdg-csd example is decorated (ssd = compositor only, no toolkit dependency; auto = prefer the compositor, fall back to the best plugin; naming a plugin forces client-side)')
